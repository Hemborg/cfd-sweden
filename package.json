{
  "name": "cfd-sweden",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:content:e2e": "node scripts/test-published-content.mjs",
    "platform:start": "node scripts/platform-local.mjs start",
    "platform:stop": "node scripts/platform-local.mjs stop",
    "platform:reset": "node scripts/platform-local.mjs reset",
    "platform:migrate": "node scripts/platform-local.mjs migrate",
    "platform:seed": "node --env-file=.env.platform.local scripts/platform-seed.mjs",
    "test:integration": "node --max-old-space-size=384 --env-file=.env.platform.local --import ./tests/integration/register-server.mjs --import tsx --test --test-isolation=none tests/integration/*.test.ts",
    "test:restore": "node --env-file=.env.platform.local scripts/platform-backup-test.mjs",
    "build:platform": "node scripts/platform-command.mjs build",
    "test:platform:e2e": "node scripts/platform-command.mjs browser",
    "platform:import": "node --env-file=.env.platform.local --import tsx scripts/platform-import-content.mts --apply-local"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "^2.0.1",
    "gray-matter": "4.0.3",
    "next": "16.4.4",
    "nodemailer": "10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "6.11.6",
    "remark": "15.0.1",
    "remark-html": "16.0.1",
    "resend": "6.37.0",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "pg": "8.23.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
